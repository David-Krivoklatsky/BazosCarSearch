# Bazcar runtime configuration (copy to .env and fill in)
# This file is committed on purpose - it contains NO secrets, only placeholders.

# Path to the scraper selector/limiter config (default: config/scraper.yaml)
BAZCAR_SCRAPER_CONFIG=config/scraper.yaml

# Log level: DEBUG | INFO | WARNING | ERROR
BAZCAR_LOG_LEVEL=INFO

# Default export directory for phase-1 JSON exports
BAZCAR_EXPORT_DIR=data/exports

# --- Phase 2: Postgres/Neon persistence ---
# Used by `bazcar scrape --db` (auto-detected when set). Schema is created
# automatically; ad_id is the dedupe key, price_history tracks price changes.
# DATABASE_URL=postgresql://user:pass@host/db

# --- Phase 3+ ---
# OPENROUTER_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=