# Bazcar runtime configuration (copy to .env and fill in)
# This file is committed on purpose - it contains NO secrets, only placeholders.

# Path to the scraper selector/limiter config (default: config/scraper.yaml)
BAZCAR_SCRAPER_CONFIG=config/scraper.yaml

# Log level: DEBUG | INFO | WARNING | ERROR
BAZCAR_LOG_LEVEL=INFO

# Default export directory for phase-1 JSON exports
BAZCAR_EXPORT_DIR=data/exports

# --- Phase 2: Postgres/Neon persistence ---
# Used by `bazcar scrape --db` (auto-detected when set). Schema is created
# automatically; ad_id is the dedupe key, price_history tracks price changes.
# DATABASE_URL=postgresql://user:pass@host/db

# --- Phase 3: LLM deal evaluation via OpenRouter ---
# Used by `bazcar scrape --eval` (auto-detected when set). The model and other
# options live in config/llm.yaml (override model with BAZCAR_OPENROUTER_MODEL).
# OPENROUTER_API_KEY=
# Fallback OpenRouter-compatible key: used for the daily model-list refresh
# and LLM calls whenever no OpenRouter key is set.
# OPENCODE_API_KEY=
# Monthly AI spend guardrail (USD, trailing 30 days). When reached, fresh
# scoring pauses and cached scores are served; /health shows spend vs cap.
# BAZCAR_MONTHLY_BUDGET_USD=

# --- Phase 4: Telegram notifications + bot ---
# `bazcar scrape --notify` alerts (auto when both set): only NEW deals, only
# whole cars, optionally filtered by score. `bazcar bot` stores preferences
# (criteria, model, min score, photos) and saved listings in the database.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# BAZCAR_TELEGRAM_MIN_SCORE=70

# --- Telegram webhook (Vercel serverless bot) ---
# Instant bot responses: deploy api/telegram.py to Vercel, then
# `bazcar webhook --url https://<project>.vercel.app/api/telegram`.
# The secret must match the Vercel env var of the same name.
# TELEGRAM_WEBHOOK_SECRET=
# Optional. Lets the bot/Mini App start a scrape right after you change filters
# or press "Process now" (otherwise results arrive on the next 15-minute cron).
# Create a GitHub fine-grained token: Settings > Developer settings > Personal
# access tokens > Fine-grained tokens > Generate. Repository access: only
# BazosCarSearch. Repository permissions: Actions = Read and write. Copy it once,
# then set GITHUB_WORKFLOW_TOKEN here (local) and in Vercel (Project > Settings >
# Environment Variables), and redeploy. Expires: pick a date and renew it then.
# GITHUB_WORKFLOW_TOKEN=

# --- Access control ---
# Comma-separated Telegram chat ids allowed to use the bot. Leave UNSET for
# open onboarding (any chat that /starts gets its own preferences — multi-user).
# BAZCAR_ALLOWED_CHAT_IDS=123456789,987654321

# --- Telegram Mini App dashboard ---
# Public URL of the dashboard (served by api/dashboard.py). When unset, the
# bot derives it from VERCEL_URL at runtime automatically.
# BAZCAR_WEBAPP_URL=https://<project>.vercel.app/api/dashboard

# --- Phase 5+ ---
# (GitHub Actions cron — no extra secrets)